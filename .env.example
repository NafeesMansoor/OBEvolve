# --- Database ---
POSTGRES_USER=obevolve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=obevolve
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://obevolve:change-me@localhost:5432/obevolve

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
# DEBUG=true makes FastAPI return full tracebacks in 500 responses (Starlette's
# built-in debug mode) — required reading during local development, but MUST
# be "false" in any real deployment: a traceback in an API response is an
# information-disclosure risk (internal paths, query text, stack frames).
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Tenancy (local dev only; production resolves tenant from subdomain) ---
DEV_TENANT_HEADER=X-Institution-Slug

# --- Object storage (S3-compatible) — used from Phase 8 (Accreditation) onward ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=obevolve-evidence

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
