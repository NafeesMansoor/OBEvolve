# Base URL of the OBEvolve backend API (see docs/ARCHITECTURE.md).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Local-dev only: sent as the X-Institution-Slug header on every request so
# the backend's tenant-resolution middleware can bind the right schema. In
# production the tenant is resolved from the subdomain instead — this var
# has no effect there. See docs/ARCHITECTURE.md §2 and ADR 0001.
VITE_INSTITUTION_SLUG=demo

# Optional: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials — enables the "Sign in
# with Google" button on the login page. Must match the backend's
# GOOGLE_CLIENT_ID exactly. Leave blank to disable; password login always
# works regardless.
VITE_GOOGLE_CLIENT_ID=
