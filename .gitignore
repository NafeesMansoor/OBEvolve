.idea/

# Logs
*.log

# Docker
docker-compose.override.yml

# Local DB dumps/backups (e.g. pre-migration safety snapshots) — never
# version-controlled, may contain real tenant data.
backups/

# Local credentials reference (dev/test logins) — never version-controlled.
docs/CREDENTIALS.local.md

# CodeCortex (codebase-mapping tool, cloned locally for indexing this repo —
# not an OBEvolve source dependency, kept out of version control)
tools/codecortex/
# CodeCortex's generated graph snapshot for this repo — a regenerable index
# cache (see CLAUDE.md), not source; can be a few MB and changes on every
# reindex.
.codecortex/
